# Route A (recommended, no waitlist): Vercel AI Gateway
#   npm i -g vercel && vercel login
#   vercel ai-gateway api-keys create --name jev --budget 5
AI_GATEWAY_API_KEY=

# Route B: direct TypeSafe API (waitlist)
# TYPESAFE_API_KEY=

# Which provider to use: gateway | typesafe | mock  (auto-detected from the keys above when unset)
# JEV_PROVIDER=

# Model id. Gateway uses typesafe-ai/jev, the direct API uses jev-latest.
# JEV_MODEL=

# Optional: text the owner via Twilio on every real quote request (otherwise printed to the console)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...

{
  "manifest_version": 3,
  "name": "jevlab unclutter",
  "version": "0.1.0",
  "description": "Sends short element descriptions to a local `jevlab unclutter serve` endpoint and hides clutter Jev identifies (reversible).",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "jevlab unclutter: toggle" }
}
